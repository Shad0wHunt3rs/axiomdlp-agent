{
  "version": 4,
  "configurations": [
    {
      "name": "Default",
      "compilerPath": "/usr/bin/x86_64-w64-mingw32-g++",
      "compileCommands": "${workspaceFolder}/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/src",
        "/usr/x86_64-w64-mingw32/include",
        "/usr/lib/gcc/x86_64-w64-mingw32/15-win32/include",
        "/usr/lib/gcc/x86_64-w64-mingw32/15-win32/include/c++",
        "/usr/lib/gcc/x86_64-w64-mingw32/15-win32/include/c++/x86_64-w64-mingw32",
        "/usr/lib/gcc/x86_64-w64-mingw32/15-win32/include/c++/backward",
        "/usr/lib/gcc/x86_64-w64-mingw32/15-win32/include-fixed"
      ],
      "defines": [
        "_WIN32",
        "WIN32",
        "WIN32_LEAN_AND_MEAN",
        "NOMINMAX",
        "_WIN32_WINNT=0x0601"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ]
}
