{
  "logging": {
    "dir": "logs",
    "file": "agent.log",
    "level": "info"
  },
  "storage": {
    "db_path": "data/agent.db"
  },
  "server": {
    "base_url": "http://127.0.0.1:3000",
    "api_token": "axdlp_user_lRXU1mczF0aHzzOx80M9leIDNcbprFfVcKPcA0tF",
    "heartbeat_interval_seconds": 60,
    "reconnect_backoff_seconds": 10,
    "reconnect_backoff_max_seconds": 300,
    "mqtt_port": 1883,
    "mqtt_tls": false,
    "mqtt_ca_path": "",
    "mqtt_keepalive_seconds": 60
  },
  "modules": {
    "filesystem_watcher": {
      "enabled": true,
      "watch_paths": [
        "/home/kali/Documents"
      ],
      "exclude_paths": [
        "*/logs/*",
        "*/.cache/*"
      ],
      "debounce_ms": 300
    },
    "inventory": {
      "enabled": true,
      "watch_paths": [
        "/home/kali/Documents"
      ],
      "exclude_paths": [
        "*/logs/*"
      ],
      "interval_seconds": 60,
      "compute_hashes": true,
      "max_file_size_bytes": 104857600,
      "scannable_categories": [
        "document",
        "code",
        "data",
        "config"
      ]
    },
    "agent_sync": {
      "enabled": true
    },
    "content_scanner": {
      "enabled": true,
      "batch_size": 50,
      "batch_max_bytes": 52428800,
      "scan_interval_seconds": 30,
      "chunk_size_bytes": 1048576,
      "chunk_overlap_bytes": 256,
      "max_file_bytes": 104857600,
      "max_retries": 3,
      "request_timeout_seconds": 300,
      "text_extensions": [
        "txt",
        "md",
        "log",
        "csv",
        "tsv",
        "json",
        "yaml",
        "yml",
        "toml",
        "xml",
        "c",
        "cpp",
        "cc",
        "cxx",
        "h",
        "hpp",
        "hxx",
        "py",
        "js",
        "ts",
        "jsx",
        "tsx",
        "go",
        "rs",
        "java",
        "kt",
        "scala",
        "cs",
        "swift",
        "rb",
        "php",
        "pl",
        "lua",
        "sql",
        "sh",
        "bash",
        "zsh",
        "ps1",
        "html",
        "css",
        "scss",
        "less",
        "conf",
        "cfg",
        "ini",
        "env",
        "properties"
      ]
    }
  }
}
