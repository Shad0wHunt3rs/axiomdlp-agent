{
  "logging": {
    "dir": "logs",
    "file": "agent.log",
    "level": "info"
  },

  "storage": {
    "db_path": "data/agent.db"
  },

  "modules": {
    "filesystem_watcher": {
      "enabled": true,
      "watch_paths": [
        "/home",
        "/tmp",
        "/var/tmp",
        "/media",
        "/mnt",
        "/opt",
        "/srv"
      ],
      "exclude_paths": [
        "*/node_modules/*",
        "*/.git/*",
        "*/__pycache__/*",
        "*/.cache/*",
        "*/logs/*",
        "/var/tmp/systemd-private-*",
        "/tmp/systemd-private-*"
      ],
      "debounce_ms": 300,
      "max_file_size_mb": 100
    },

    "inventory": {
      "enabled": true,
      "watch_paths": [
        "/home",
        "/etc",
        "/opt",
        "/root",
        "/tmp",
        "/var/tmp"
      ],
      "exclude_paths": [
        "*/.git/*",
        "*/node_modules/*",
        "*/.cache/*",
        "*/__pycache__/*",
        "*/build/*",
        "*/dist/*",
        "*/target/*",
        "*/.gradle/*",
        "*/.m2/*",
        "*/.npm/*",
        "*/.cargo/*",
        "/var/lib/docker/*",
        "/var/lib/containers/*",
        "/proc/*",
        "/sys/*",
        "/dev/*",
        "/snap/*",
        "/var/log/*"
      ],
      "interval_seconds": 900
    }
  }
}