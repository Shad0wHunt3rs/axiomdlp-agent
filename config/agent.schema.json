{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiomdlp.example.com/schemas/agent.schema.json",
  "title": "AxiomDLP Agent Configuration",
  "description": "Configuration file for the AxiomDLP endpoint agent.",
  "type": "object",
  "properties": {
    "logging": {
      "type": "object",
      "description": "Logging subsystem configuration.",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Directory where log files are written.",
          "default": "logs"
        },
        "file": {
          "type": "string",
          "description": "Log filename inside the log directory.",
          "default": "agent.log"
        },
        "level": {
          "type": "string",
          "description": "Minimum log level.",
          "enum": ["trace", "debug", "info", "warn", "error", "critical", "off"],
          "default": "info"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}