{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiomdlp.example.com/schemas/agent.schema.json",
  "title": "AxiomDLP Agent Configuration",
  "description": "Configuration file for the AxiomDLP endpoint agent.",
  "type": "object",

  "properties": {
    "logging": {
      "type": "object",
      "description": "Logging subsystem configuration.",
      "properties": {
        "dir":   { "type": "string", "default": "logs" },
        "file":  { "type": "string", "default": "agent.log" },
        "level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error", "critical", "off"],
          "default": "info"
        }
      },
      "additionalProperties": false
    },

    "storage": {
      "type": "object",
      "description": "Local persistence configuration.",
      "properties": {
        "db_path": { "type": "string", "default": "data/agent.db" }
      },
      "additionalProperties": false
    },

    "modules": {
      "type": "object",
      "description": "Per-module configuration.",
      "properties": {

        "filesystem_watcher": {
          "type": "object",
          "description": "Real-time filesystem event watcher.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "watch_paths": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "exclude_paths": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "debounce_ms": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            }
          },
          "additionalProperties": false
        },

        "inventory": {
          "type": "object",
          "description": "Periodic filesystem metadata scan.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "watch_paths": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "exclude_paths": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "interval_seconds": {
              "type": "integer",
              "minimum": 10,
              "default": 900
            }
          },
          "additionalProperties": false
        },

        "transport": {
          "type": "object",
          "description": "WebSocket push channel to the core server.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "server_url": {
              "type": "string",
              "default": "ws://127.0.0.1:8765"
            },
            "reconnect_backoff_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "reconnect_backoff_max_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            },
            "verify_tls": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },

        "agent_sync": {
          "type": "object",
          "description": "HTTP enrollment + heartbeat to the core server.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "http_base_url": {
              "type": "string",
              "default": "http://127.0.0.1:3000"
            },
            "api_token": {
              "type": "string",
              "default": ""
            },
            "heartbeat_interval_seconds": {
              "type": "integer",
              "minimum": 5,
              "default": 30
            },
            "verify_tls": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },

  "additionalProperties": true
}