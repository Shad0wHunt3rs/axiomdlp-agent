{
  "logging": {
    "dir": "logs",
    "file": "agent.log",
    "level": "info"
  },
  "storage": {
    "db_path": "data/agent.db"
  },
  "server": {
    "base_url": "http://192.168.1.42:3000",
    "api_token": "",
    "heartbeat_interval_seconds": 60,
    "reconnect_backoff_seconds": 10,
    "reconnect_backoff_max_seconds": 300,
    "grpc_port": 50051,
    "grpc_tls": false,
    "grpc_ca_path": ""
  },
  "modules": {
    "filesystem_watcher": {
      "enabled": true,
      "watch_paths": [
        "%USERPROFILE%"
      ],
      "exclude_paths": [
        "*/node_modules/*",
        "*/.git/*",
        "*/AppData/Local/Temp/*",
        "*/AppData/Local/Microsoft/Windows/INetCache/*",
        "*/AppData/Local/Packages/*/LocalCache/*",
        "*/AppData/Local/Microsoft/Windows/Explorer/*",
        "*/AppData/Roaming/Microsoft/Windows/Recent/*"
      ],
      "debounce_ms": 300
    },
    "inventory": {
      "enabled": true,
      "watch_paths": [
        "%USERPROFILE%",
        "%PUBLIC%",
        "%ProgramData%",
        "%ProgramFiles%",
        "%SystemRoot%"
      ],
      "exclude_paths": [
        "*/node_modules/*",
        "*/.git/*",
        "*/AppData/Local/Temp/*",
        "*/AppData/Local/Microsoft/Windows/INetCache/*",
        "*/AppData/Local/Packages/*/LocalCache/*",
        "*/AppData/Local/Microsoft/Windows/Explorer/*",
        "*/AppData/Roaming/Microsoft/Windows/Recent/*",
        "*/AppData/Local/CrashDumps/*",
        "*/Windows/WinSxS/*",
        "*/Windows/assembly/*",
        "*/Windows/System32/*",
        "*/Windows/SysWOW64/*",
        "*/Windows/Installer/*",
        "*/Windows/Logs/*",
        "*/ProgramData/Microsoft/Windows Defender/*",
        "*/ProgramData/Microsoft/Windows/Caches/*",
        "*/ProgramData/Package Cache/*",
        "*/$Recycle.Bin/*",
        "*/System Volume Information/*"
      ],
      "interval_seconds": 900,
      "compute_hashes": true,
      "max_file_size_bytes": 104857600,
      "scannable_categories": [
        "document",
        "code",
        "data",
        "config"
      ]
    },
    "agent_sync": {
      "enabled": true
    },
    "content_scanner": {
      "enabled": true,
      "batch_size": 50,
      "batch_max_bytes": 52428800,
      "scan_interval_seconds": 30,
      "chunk_size_bytes": 1048576,
      "chunk_overlap_bytes": 256,
      "max_file_bytes": 104857600,
      "max_retries": 3,
      "request_timeout_seconds": 300,
      "text_extensions": [
        "txt", "md", "log", "csv", "tsv", "json", "yaml", "yml", "toml", "xml",
        "c", "cpp", "cc", "cxx", "h", "hpp", "hxx", "py", "js", "ts", "jsx", "tsx",
        "go", "rs", "java", "kt", "scala", "cs", "swift", "rb", "php", "pl", "lua",
        "sql", "sh", "bash", "zsh", "ps1", "html", "css", "scss", "less", "conf",
        "cfg", "ini", "env", "properties"
      ]
    }
  }
}